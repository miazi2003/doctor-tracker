NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/doctor-tracker
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d
AUTH_COOKIE_NAME=doctor_tracker_auth
JSON_BODY_LIMIT=16kb
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
# The built-in login limiter is instance-local. On serverless deployments it is
# not a globally shared limit; use a distributed store if global enforcement is required.
# Set true only when production traffic passes through one trusted reverse proxy.
TRUST_PROXY=false
ADMIN_NAME=Initial Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Explicitly opt in only when intentionally inserting fictional demo records.
DEMO_SEED_ENABLED=false
